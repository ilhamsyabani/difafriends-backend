APP_NAME="Difafriends"
APP_ENV=production
APP_KEY=base64:mwdNq/bg/qZ/R2MI1oEqLPkHnIqu4jvntJpdo8LbvFY=
APP_DEBUG=false
APP_URL=https://domain-kamu.id

# Database PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=difafriends
DB_USERNAME=difafriends_user
DB_PASSWORD=ganti_dengan_password_aman

# Cache & Queue — pakai Redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email — ganti ke provider real (Mailgun, Resend, dll)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@domain-kamu.id"
MAIL_FROM_NAME="DifaFriends"

# Storage — Cloudflare R2 (untuk video & file)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=difafriends
AWS_URL=https://xxxxx.r2.cloudflarestorage.com
AWS_ENDPOINT=https://xxxxx.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# Midtrans — PRODUCTION keys
MIDTRANS_SERVER_KEY=Mid-server-PRODUCTION_KEY_DISINI
MIDTRANS_CLIENT_KEY=Mid-client-PRODUCTION_KEY_DISINI
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# Log
LOG_CHANNEL=daily
LOG_LEVEL=error
